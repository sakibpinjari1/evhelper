NODE_ENV=development
PORT=5000

# Database and auth
MONGO_URI=mongodb://localhost:27017/evhelper
JWT_SECRET=replace_with_strong_secret

# IoT (Blynk)
BLYNK_AUTH_TOKEN=replace_with_blynk_token

# IoT safety controls
# true: backend exits on startup if BLYNK_AUTH_TOKEN is missing
IOT_STRICT_MODE=false
# true: enables /api/iot/relay/test (no hardware write, emits test events only)
IOT_ALLOW_RELAY_TEST=false
# minimum gap between relay writes in ms
IOT_RELAY_MIN_INTERVAL_MS=1500
